
/* Moving background slideshow */
.background-slider {
  position: fixed;
  inset: 0;
  z-index: -2;
  overflow: hidden;
}

.background-track {
  display: flex;
  width: 600vw;
  height: 100%;
  animation: slideBackground 45s linear infinite;
  will-change: transform;
}

.background-track img {
  display: block;
  flex: 0 0 100vw;
  width: 100vw;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

@keyframes slideBackground {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-300vw);
  }
}

/* Dark overlay for text readability */
.page-overlay {
  position: fixed;
  inset: 0;
  z-index: -1;
  background: linear-gradient(
    90deg,
    rgba(3, 17, 39, 0.85),
    rgba(3, 17, 39, 0.48)
  );
  pointer-events: none;
}

/* Keep the navigation simple */
.navbar nav {
  display: flex;
  align-items: center;
  gap: 20px;
}

.navbar nav a {
  color: white;
  text-decoration: none;
}

@media (max-width: 768px) {
  .background-track {
    animation-duration: 36s;
  }

  .navbar nav {
    gap: 10px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .background-track {
    animation: none;
  }
}
